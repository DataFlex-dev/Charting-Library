                        Send UpdateChart of oMultiseriesChart
                    End_Procedure
                End_Object

                //WebCombo that allows the charting library to be set
                Object oMultiseriesChartLibraryCombo is a cWebCombo
                    Set psLabel to "Chart library"
                    Set psValue to "Chartjs"
                    Set pbServerOnChange to True
                    Set piColumnSpan to 2
        
                    Procedure OnFill
                        Send AddComboItem "Chartjs" clChartjs
                        Send AddComboItem "HighCharts" clHighCharts
                        Send AddComboItem "Syncfusion" clSyncfusion
                    End_Procedure
                    
                    Procedure OnChange String sNewValue String sOldValue
                        WebSet psChartingLibrary of oMultiseriesChart to sNewValue
                        Send Refill of oMultiseriesChartTypeCombo
                    End_Procedure
                End_Object
                
                //ChartControl that demonstrates how multiseries charts work
                Object oMultiseriesChart is a cChart
                    Set psTitle to "Multiseries charts"
                    Set psSubtitle to "Click on a dataset to remove it from the chart!"
                    Set psChartBackgroundColor to "white"
                    Set psYAxisLabel to "Total sales"
                    //Left or right
                    Set psLegendAlignment to "right"
                    Set piColumnSpan to 10
                    Set pbFillHeight to True

                    Procedure OnLoad
                        String sChartingLibrary sChartType
                    
                        //Get the charting library
                        WebGet psValue of oMultiseriesChartLibraryCombo to sChartingLibrary
                        WebSet psChartingLibrary of oMultiseriesChart to sChartingLibrary
                        
                        //Get the chart type
                        WebGet psValue of oMultiseriesChartTypeCombo to sChartType
                        WebSet psChartType of oMultiseriesChart to sChartType
                        
                        Send CreateMultiseriesChart
                    End_Procedure
                    
                    Procedure OnClick String sLabel Number nValue String sTooltip Integer iIndex String sDatasetName
                        Send RemoveDataset sDatasetName
                    End_Procedure
                End_Object

                //Loads in all the data for the multiseries chart
                Procedure CreateMultiseriesChart
                    String sXAxisLabels
                    String[] sSalesPersons sDates
                    tChartData[] chartData
                    Integer iCount iIndex iDateIndex iLoopCount iDateCount
                    
                    Move 0 to iCount
                    
                    Send Clear of oOrderHeader_DD                    
                    Send Find of oOrderHeader_DD GE 3
                    
                    //Only get the first 100 records
                    While (Found and iCount < 100)
                        
                        Move (SearchArray(OrderHeader.Order_Date, sDates)) to iDateIndex
                        
                        If (iDateIndex = -1) Begin
                            Move (Trim(OrderHeader.Order_Date)) to sDates[iDateIndex]
                        End
                        
                        Move (SearchArray((Trim(SalesPerson.Name)), sSalesPersons)) to iIndex
                        
                        If (iIndex = -1) Begin
                            Move (Trim(SalesPerson.Name)) to sSalesPersons[-1]
                            Move OrderHeader.Order_Total to chartData[iIndex].dataPoints[iDateIndex].y
                        End
                        Else Begin
                            Move OrderHeader.Order_Total to chartData[iIndex].dataPoints[iDateIndex].y
                        End
                          
                        Increment iCount
                        Send Find of oOrderHeader_DD NEXT_RECORD 3
                    Loop
                    
                    For iLoopCount from 0 to (SizeOfArray(sSalesPersons)-1)
                        Move sSalesPersons[iLoopCount] to chartData[iLoopCount].sLabel
                    Loop
                    
                    For iDateCount from 0 to (SizeOfArray(sDates)-1)
                        
                        If (SizeOfString(sXAxisLabels)=0) Begin
                            Move sDates[iDateCount] to sXAxisLabels
                        End
                        Else Begin
                            Append sXAxisLabels (", " + sDates[iDateCount])
                        End
                    Loop
                    
                    WebSet psXAxisLabels of oMultiseriesChart to sXAxisLabels
                    
                    Send CreateChart of oMultiseriesChart chartData
                End_Procedure
                            
            End_Object
            
        End_Object
        
    End_Object

    Procedure OnLoad
        String[] asChartjsTypes asHighChartsTypes asSyncfusionTypes
        
        Forward Send OnLoad
        
        //Define chartjs types 
        Move "line" to asChartjsTypes[-1]
        Move "bar" to asChartjsTypes[-1]
        Move "doughnut" to asChartjsTypes[-1]
        Move "pie" to asChartjsTypes[-1]
        Move "scatter" to asChartjsTypes[-1]
        Move "bubble" to asChartjsTypes[-1]
        Move "polarArea" to asChartjsTypes[-1]
        Move "radar" to asChartjsTypes[-1]
        
        //Define HighCharts types
        Move "line" to asHighChartsTypes[-1]
        Move "bar" to asHighChartsTypes[-1]
        Move "column" to asHighChartsTypes[-1]
        Move "area" to asHighChartsTypes[-1]
        Move "pie" to asHighChartsTypes[-1]
        Move "areaspline" to asHighChartsTypes[-1]
        Move "scatter" to asHighChartsTypes[-1]
        Move "spline" to asHighChartsTypes[-1]
        
        //Define Syncfusion types
        Move "line" to asSyncfusionTypes[-1]
        Move "bar" to asSyncfusionTypes[-1]
        Move "column" to asSyncfusionTypes[-1]
        Move "pie" to asSyncfusionTypes[-1]
        Move "doughnut" to asSyncfusionTypes[-1]
        Move "area" to asSyncfusionTypes[-1]
        Move "radar" to asSyncfusionTypes[-1]
        Move "scatter" to asSyncfusionTypes[-1]
        Move "bubble" to asSyncfusionTypes[-1]
        
        WebSet pasChartjsTypes to asChartjsTypes
        WebSet pasHighChartsTypes to asHighChartsTypes
        WebSet pasSyncfusionTypes to asSyncfusionTypes
    End_Procedure
    
    //Gets the charttypes of the specified chart library
    Function ChartTypes String sChartLibrary Returns String[]
        String[] asTypes
        
        Case Begin
            Case (sChartLibrary = clChartjs)
                WebGet pasChartjsTypes to asTypes
                Break
            Case (sChartLibrary = clHighCharts)
                WebGet pasHighChartsTypes to asTypes
                Break
            Case (sChartLibrary = clSyncfusion)
                WebGet pasSyncfusionTypes to asTypes
                Break
        Case End
        
        Function_Return asTypes
    End_Function
    
End_Object

